generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────
// Better Auth tables
// ──────────────────────────────
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions Session[]
  accounts Account[]
  posts    BlogPost[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ──────────────────────────────
// Blog
// ──────────────────────────────
model BlogPost {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  excerpt            String
  body               Json     // stored as string[]
  coverImage         String?  // Cloudinary URL
  coverImageAlt      String?
  coverPublicId      String?  // Cloudinary public_id for management
  date               DateTime @default(now())
  published          Boolean  @default(false)
  featured           Boolean  @default(false)
  readingTimeMinutes Int?     @default(5)
  authorId           String?
  author             User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ──────────────────────────────
// Store
// ──────────────────────────────
enum ProductCategory {
  SHEETS
  STONE_COATED
  ACCESSORIES
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum OrderSource {
  STORE
  ROOF_CALCULATOR
}

enum PaymentMethod {
  PAYSTACK
  BANK_TRANSFER
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String           @default("")
  category      ProductCategory
  unit          String           @default("sqm") // "sqm" | "piece" | "pack" | "bundle"
  basePriceKobo Int? // used only when the product has no variants
  inStock       Boolean          @default(true)
  published     Boolean          @default(false)
  featured      Boolean          @default(false)
  sortOrder     Int              @default(0)
  images        Json             @default("[]") // [{ url, publicId, alt }]
  videoUrl      String? // Cloudinary secure_url
  videoPublicId String?
  variants      ProductVariant[]
  orderItems    OrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String // "0.45MM", "Shingle Tiles"
  priceKobo  Int // price per product.unit, in kobo
  inStock    Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, label])
}

model Order {
  id                String      @id @default(cuid())
  reference         String      @unique // "GPA-…" — also the Paystack transaction reference
  status            OrderStatus @default(PENDING)
  source            OrderSource @default(STORE)
  paymentMethod     PaymentMethod @default(PAYSTACK)
  customerName      String
  customerEmail     String
  customerPhone     String
  deliveryAddress   String? // not collected yet for ROOF_CALCULATOR quotes
  note              String?
  subtotalKobo      Int // materials only; delivery quoted separately
  calculatorDetails Json? // roof shape/dims/pitch/accessories snapshot, ROOF_CALCULATOR only
  paidAt            DateTime?
  paystackId        String? // Paystack transaction id from verify/webhook
  channel           String? // "card" | "bank" | "ussd" …
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  nameSnapshot    String // product name at purchase time
  variantSnapshot String? // variant label at purchase time
  unit            String
  unitPriceKobo   Int // DB-derived price at purchase, never client price
  quantity        Float // sqm for ROOF_CALCULATOR items, piece count for STORE items
  lineTotalKobo   Int
}

// Singleton row (id is always "singleton") holding the dealer's bank account
// details shown to customers who choose BANK_TRANSFER at checkout.
model BankTransferSettings {
  id            String   @id @default("singleton")
  bankName      String   @default("")
  accountNumber String   @default("")
  accountName   String   @default("")
  instructions  String?
  updatedAt     DateTime @updatedAt
}
