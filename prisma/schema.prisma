generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────
// Better Auth tables
// ──────────────────────────────
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions Session[]
  accounts Account[]
  posts    BlogPost[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ──────────────────────────────
// Blog
// ──────────────────────────────
model BlogPost {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  excerpt            String
  body               Json // stored as string[]
  coverImage         String? // Cloudinary URL
  coverImageAlt      String?
  coverPublicId      String? // Cloudinary public_id for management
  date               DateTime @default(now())
  published          Boolean  @default(false)
  featured           Boolean  @default(false)
  readingTimeMinutes Int?     @default(5)
  authorId           String?
  author             User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ──────────────────────────────
// Store
// ──────────────────────────────
enum ProductCategory {
  SHEETS
  STONE_COATED
  ACCESSORIES
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum OrderSource {
  STORE
  ROOF_CALCULATOR
}

enum PaymentMethod {
  PAYSTACK
  BANK_TRANSFER
}

// ──────────────────────────────
// Branches
//
// Every price in the store is resolved against a branch. The default branch
// (exactly one row with isDefault = true — Lagos) is priced straight off
// Product.basePriceKobo / ProductVariant.priceKobo, so the existing catalogue
// keeps working untouched.
//
// Every other branch is *override-only*: it sells an item only if there is a
// matching BranchProductPrice / BranchVariantPrice row. Row absence means "not
// stocked here", which is what we want — the Enugu branch carries four gauges
// per profile against Lagos's eleven, so falling back to the Lagos price would
// silently list stock Enugu doesn't have.
// ──────────────────────────────
model Branch {
  id        String  @id @default(cuid())
  slug      String  @unique // "lagos" | "enugu"
  name      String // "Lagos Factory"
  shortName String // "Lagos" — used in the selector and price badges
  isDefault Boolean @default(false)
  published Boolean @default(true)
  sortOrder Int     @default(0)

  addressLine String // free text; the Enugu branch only gave us "Enugu–PH Expressway"
  locality    String // "Alimosho" | "Enugu"
  region      String // "Lagos" | "Enugu"
  phoneE164   String
  whatsappUrl String

  // Date printed on the branch's own paper price list, shown to customers so a
  // stale list is visible rather than implied.
  priceListDate DateTime?
  note          String?

  productPrices BranchProductPrice[]
  variantPrices BranchVariantPrice[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-branch price for a product that has no variants (accessories).
model BranchProductPrice {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceKobo Int
  inStock   Boolean @default(true)

  @@unique([branchId, productId])
  @@index([branchId])
}

// Per-branch price for a single variant (gauge / tile design).
model BranchVariantPrice {
  id        String         @id @default(cuid())
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId String // denormalised so a branch's catalogue is one query
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceKobo Int
  inStock   Boolean        @default(true)

  @@unique([branchId, variantId])
  @@index([branchId, productId])
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String           @default("")
  category      ProductCategory
  unit          String           @default("sqm") // "sqm" | "piece" | "pack" | "bundle"
  basePriceKobo Int? // default-branch price; used only when the product has no variants
  inStock       Boolean          @default(true)
  published     Boolean          @default(false)
  featured      Boolean          @default(false)
  sortOrder     Int              @default(0)
  images        Json             @default("[]") // [{ url, publicId, alt }]
  videoUrl      String? // Cloudinary secure_url
  videoPublicId String?
  variants      ProductVariant[]
  orderItems    OrderItem[]

  branchPrices        BranchProductPrice[]
  branchVariantPrices BranchVariantPrice[]
  reviews             Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String // "0.45MM", "Shingle Tiles"
  priceKobo  Int // default-branch price per product.unit, in kobo
  inStock    Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  branchPrices BranchVariantPrice[]

  @@unique([productId, label])
}

model Order {
  id                String             @id @default(cuid())
  reference         String             @unique // "GPA-…" — also the Paystack transaction reference
  status            OrderStatus        @default(PENDING)
  source            OrderSource        @default(STORE)
  paymentMethod     PaymentMethod      @default(PAYSTACK)
  customerName      String
  customerEmail     String
  customerPhone     String
  deliveryAddress   String? // not collected yet for ROOF_CALCULATOR quotes
  note              String?
  // Which branch priced and fulfils this order. branchSnapshot keeps the name
  // readable on old orders if the branch row is ever renamed or removed.
  branchId          String?
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchSnapshot    String?
  subtotalKobo      Int // materials only; delivery quoted separately
  calculatorDetails Json? // roof shape/dims/pitch/accessories snapshot, ROOF_CALCULATOR only
  paidAt            DateTime?
  paystackId        String? // Paystack transaction id from verify/webhook
  channel           String? // "card" | "bank" | "ussd" …
  items             OrderItem[]
  reviews           Review[]
  reviewInvitations ReviewInvitation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  nameSnapshot    String // product name at purchase time
  variantSnapshot String? // variant label at purchase time
  unit            String
  unitPriceKobo   Int // DB-derived price at purchase, never client price
  quantity        Float // sqm for ROOF_CALCULATOR items, piece count for STORE items
  lineTotalKobo   Int
}

// Singleton row (id is always "singleton") holding the dealer's bank account
// details shown to customers who choose BANK_TRANSFER at checkout.
model BankTransferSettings {
  id            String   @id @default("singleton")
  bankName      String   @default("")
  accountNumber String   @default("")
  accountName   String   @default("")
  instructions  String?
  updatedAt     DateTime @updatedAt
}

// ──────────────────────────────
// Customer reviews
//
// Every row here is something a real person typed. Nothing in the app writes
// a Review on a customer's behalf, and nothing publishes one without a human
// approving it first — the aggregateRating/review JSON-LD on the product
// pages is computed straight off APPROVED rows, so an invented review here
// becomes an invented rich-result star rating in Google. That is a Google
// review-snippet policy violation and, in several markets, illegal.
//
// verifiedPurchase is only ever set by the invitation flow below, where the
// token proves the reviewer is the buyer on a PAID/FULFILLED order.
// ──────────────────────────────
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Where the words came from. This is an audit trail, not a display field:
// WEB_FORM means the customer typed it themselves; WHATSAPP_IMPORT means a
// member of staff transcribed a message a real customer sent. Anything
// imported carries sourceNote naming who transcribed it and when, so a
// review's provenance stays checkable years later.
enum ReviewSource {
  WEB_FORM
  WHATSAPP_IMPORT
  EMAIL_IMPORT
}

model Review {
  id     String  @id @default(cuid())
  rating Int // 1–5, validated at the API boundary
  title  String?
  body   String

  // Shown publicly. authorLocation is free text ("Ikeja, Lagos") and is the
  // only location signal — we never publish the submitter's email.
  authorName     String
  authorLocation String?
  // Optional: offline reviews transcribed from WhatsApp often have a phone
  // number as the only contact detail, and some customers give neither.
  submitterEmail String?
  submitterPhone String?

  source           ReviewSource @default(WEB_FORM)
  // For imported reviews: who transcribed it, from what, and when the
  // customer sent it. Free text, admin-only, never rendered publicly.
  sourceNote       String?
  // Whether the customer agreed to their words appearing publicly. Imports
  // start false and must be set deliberately — see lib/reviews/import.ts.
  consentToPublish Boolean      @default(false)

  status         ReviewStatus @default(PENDING)
  moderationNote String? // admin-only; why a review was rejected
  publishedAt    DateTime? // set when status first becomes APPROVED

  // Which product the review is about. Null = a review of the business as a
  // whole, which shows on /reviews but never feeds a Product aggregateRating.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Provenance. Set together by the invitation flow; both null for reviews
  // submitted from the open form.
  orderId          String?
  order            Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  verifiedPurchase Boolean @default(false)

  invitation ReviewInvitation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, productId])
  @@index([status, publishedAt])
}

// A single-use token emailed to the buyer of a PAID/FULFILLED order. This is
// the honest path to review volume: real customers, invited once, writing
// their own words. usedAt makes it single-use; expiresAt caps the window.
model ReviewInvitation {
  id    String @id @default(cuid())
  token String @unique

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Denormalised from the order at send time so the form can greet the buyer
  // and pre-fill the product without exposing the order record.
  recipientEmail String
  recipientName  String

  sentAt    DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  // Set once the invitation is redeemed, so a token can't produce a second review.
  reviewId String? @unique
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ──────────────────────────────
// TikTok (Display API — see docs/tiktok-integration-plan.md)
// ──────────────────────────────

// Singleton row (id is always "singleton") holding the OAuth tokens for the
// connected business TikTok account, used to read its own video list.
model TikTokConnection {
  id                    String   @id @default("singleton")
  openId                String
  accessToken           String
  accessTokenExpiresAt  DateTime
  refreshToken          String
  refreshTokenExpiresAt DateTime
  scope                 String
  updatedAt             DateTime @updatedAt
}

// Videos staff picked from the connected account's video list (app/admin/tiktok)
// to show in the "Follow us on TikTok" strip on /gallery.
model FeaturedTikTokVideo {
  id        String   @id @default(cuid())
  videoId   String   @unique // TikTok's numeric video ID
  caption   String? // admin reference only — TikTokEmbed pulls the real caption at render time
  sortOrder Int      @default(0)
  addedAt   DateTime @default(now())
}
